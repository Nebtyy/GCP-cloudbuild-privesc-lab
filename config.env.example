# =========================== EDIT ME ===========================
# Your billing account ID. Get it with:  gcloud billing accounts list
# Format looks like: 0X0X0X-0X0X0X-0X0X0X
BILLING_ACCOUNT="XXXXXX-XXXXXX-XXXXXX"

# Leave EMPTY to create a fresh, throwaway project (recommended: teardown = delete project).
# Or set an existing project ID to build the lab inside it (teardown only removes lab resources).
USE_EXISTING_PROJECT=""

# Region used for the Cloud Build run.
REGION="us-central1"

# Fictional brand. NOTHING here maps to any real organization - rename freely.
ORG_SLUG="acme"
PROJECT_NAME="Acme Metastore LAB"
# ===============================================================

# --- Identity names below. They are generic labels for a common real-world
# --- misconfiguration pattern; safe to keep as-is or rename freely. ---

# Over-privileged Cloud Build deployer service account
DEPLOYER_SA="cloudbuild-deployer"

# Non-owner principal allowed to start builds (holds roles/cloudbuild.builds.editor)
LOWPRIV_SA="lowpriv-builder"

# An 'editor' service account used as the impersonation target for the residual path
RUNTIME_SA="app-runtime"

# A dummy secret to prove post-escalation data access (value is random, never a real secret)
SECRET_NAME="demo-app-secret"
